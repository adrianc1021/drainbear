# =============================================================================
# 通渠熊 DrainBear — 環境變數說明
# 只列變數名稱及用途;真實值放入 .env(已 gitignore)或 Render 環境變數設定。
# 絕不可將真實 Secret 提交到 Git。
# =============================================================================

# -----------------------------------------------------------------------------
# 前端(VITE_ 前綴會打包進瀏覽器 — 只可放公開值,絕不可放 Secret)
# -----------------------------------------------------------------------------

# GA4 Measurement ID(格式 G-XXXXXXXXXX)。未設定時網站正常運作,GA4 不載入。
# Preview / 開發環境請留空或使用另一個測試 Property,避免污染正式數據。
VITE_GA4_MEASUREMENT_ID=

# (可選)開發環境 GA4 DebugView 上報。設 "true" 時 dev 環境亦會上報並帶 debug_mode。
VITE_GA4_DEBUG=

# -----------------------------------------------------------------------------
# 伺服器端(不可加 VITE_ 前綴)
# -----------------------------------------------------------------------------

# 伺服器埠(Render 自動注入 PORT)
PORT=

# MySQL 連線字串(Drizzle ORM)
DATABASE_URL=

# Session JWT 簽名密鑰
JWT_SECRET=

# =============================================================================
# 以下為後續階段(第四階段 Admin Dashboard)預留,現階段毋須設定
# =============================================================================

# Google OAuth(Admin 後台登入;伺服器端流程,Secret 絕不入前端)
# Callback URL: https://drainbearhk.com/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# 允許登入後台的電郵白名單(逗號分隔)
# ADMIN_ALLOWED_EMAILS=

# GA4 Data API(Service Account;Private Key 只可存於伺服器端)
# GA4_PROPERTY_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
